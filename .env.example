# Set these to your router management IP addresses.
ROUTER_A_NAME=JioFiber
ROUTER_A_IP=192.168.1.1
ROUTER_B_NAME=Repeater
ROUTER_B_IP=192.168.1.2

SCAN_INTERVAL_SECONDS=30
DATABASE_PATH=data/routerguard.db

# Optional comma-separated MAC addresses you have identified and approved.
KNOWN_MACS=

# Optional simultaneous router RSSI collection.
# These must be documented/read-only JSON endpoints that return RSSI in dBm.
# JioFiber often does not expose a standard public RSSI API; leave blank until verified.
MAIN_ROUTER_NAME=JioFiber Main
MAIN_ROUTER_RSSI_URL=
MAIN_ROUTER_RSSI_TOKEN=
MAIN_ROUTER_RSSI_JSON_FIELD=rssi

SECOND_ROUTER_NAME=Second Router
SECOND_ROUTER_RSSI_URL=
SECOND_ROUTER_RSSI_TOKEN=
SECOND_ROUTER_RSSI_JSON_FIELD=rssi
