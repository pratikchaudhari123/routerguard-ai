menu "WiFiSense receiver configuration"

config WIFISENSE_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        SSID of the existing 2.4 GHz Wi-Fi network used by the receiver.

config WIFISENSE_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
        Password for the existing Wi-Fi network. Keep sdkconfig local and never commit credentials.

config WIFISENSE_API_URL
    string "RouterGuard CSI API URL"
    default "http://192.168.31.131:8000/api/csi"
    help
        Use the MacBook's reachable LAN IPv4 address, not localhost.

config WIFISENSE_DEVICE_ID
    string "CSI receiver device ID"
    default "esp32-s3-csi-01"
    help
        Stable identifier for this CSI receiver.

endmenu
